# SYNAPTOX — SOZLAMALAR NAMUNASI (haqiqiy sirlarni faqat .env faylida saqlang)
PORT=3000
NODE_ENV=production
# FFmpeg PATH'da bo'lmasa, ffmpeg.exe va ffprobe.exe papkasini ko'rsating:
# FFMPEG_BIN_DIR=C:\tools\ffmpeg\bin
SESSION_SECRET=change-me-with-a-random-secret-at-least-32-characters
ENC_KEY=change-me-with-a-random-encryption-key-at-least-32-chars
# DIQQAT: ENC_KEY ni yo'qotsangiz, shifrlangan chat va fayllarni qayta tiklab bo'lmaydi. Zaxira nusxasini saqlang!

TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
CONTACT_TG=@replace-with-your-contact

# To'lov rekvizitlari (to'ldiring, aks holda "Sotib olish" ishlamaydi)
PAY_CARD=
PAY_CARD_OWNER=
PRICE_PRO=49000
PRICE_MAX=99000

# Ixtiyoriy AI (bo'sh bo'lsa ham o'z bazasi ishlaydi)
# Tashqi AI (OpenAI-mos API): masalan https://api.openai.com/v1 yoki boshqa provayder
# Internetdan izlash (Tavily kaliti)
SEARCH_KEY=
LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_KEY=
LLM_MODEL=gemini-3.6-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
STT_URL=http://localhost:9000
TRUST_PROXY=0
DOMAIN=localhost

# Coze (ixtiyoriy): token va bot_id
COZE_TOKEN=
COZE_BOT_ID=
COZE_URL=https://api.coze.com
